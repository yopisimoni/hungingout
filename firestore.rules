rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // Places catalogue (read-only from the app) + public likes and reviews per place.
    match /places/{placeId} {
      allow read: if true;
      allow write: if false;

      match /likes/{uid} {
        allow read: if true;
        allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['at']);
        allow delete: if isMe(uid);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
                      && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'stars', 'at'])
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
                      && request.resource.data.name is string && request.resource.data.name.size() <= 80
                      && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    // Each user's private space: profile, favorites, likes mirror, comments mirror.
    match /users/{uid} {
      allow read, write: if isMe(uid);
      match /{document=**} {
        allow read, write: if isMe(uid);
      }
    }

    // Plans: open by link, owner can list their own, only owner edits.
    match /plans/{planId} {
      allow get: if true;
      allow list: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.stops is list
                    && request.resource.data.stops.size() <= 6;
      allow update, delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /votes/{uid} {
        allow get, list: if true;
        allow write: if isMe(uid);
      }
    }

    // Public feed of shared places.
    match /feed/{postId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'pid', 'city', 'emoji', 'text', 'at'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280
                    && request.resource.data.name is string && request.resource.data.name.size() <= 80
                    && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Reports on posts / reviews: write-only, read from the console.
    match /reports/{id} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['kind', 'ref', 'uid', 'at'])
                    && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // "List my place" requests from venue owners: write-only from the app.
    match /listingRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'city', 'type', 'price', 'contact', 'lang', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120
                    && request.resource.data.contact is string && request.resource.data.contact.size() <= 120;
      allow read, update, delete: if false;
    }
  }
}
