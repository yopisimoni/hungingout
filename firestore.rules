rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Admins are added by hand in the Firebase console (document id = the admin's user UID).
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    // Venues listed by their owners. New venues start 'pending'; only an admin changes the status.
    function validVenue(d) {
      return d.keys().hasOnly(['owner', 'name', 'city', 'cat', 'area', 'vibe', 'priceMin', 'priceMax', 'desc', 'hours', 'phone', 'insta', 'maps', 'menu', 'offers', 'status', 'at', 'updated'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.city in ['casa', 'rabat', 'rak', 'tng', 'aga', 'fes', 'khn']
        && d.cat in ['cafe', 'food', 'roof', 'act']
        && d.vibe in ['casual', 'chic', 'luxe']
        && d.priceMin is int && d.priceMax is int && d.priceMin >= 0 && d.priceMax >= d.priceMin && d.priceMax <= 5000
        && d.area is string && d.area.size() <= 60
        && d.desc is string && d.desc.size() <= 600
        && d.hours is string && d.hours.size() <= 120
        && d.phone is string && d.phone.size() <= 30
        && d.insta is string && d.insta.size() <= 60
        && d.maps is string && d.maps.size() <= 300
        && d.menu is list && d.menu.size() <= 40
        && d.offers is list && d.offers.size() <= 6;
    }
    match /venues/{vid} {
      allow read: if resource.data.status == 'live'
                  || (signedIn() && resource.data.owner == request.auth.uid)
                  || isAdmin();
      allow create: if signedIn()
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && validVenue(request.resource.data);
      allow update: if (signedIn() && resource.data.owner == request.auth.uid
                        && request.resource.data.owner == resource.data.owner
                        && request.resource.data.status == resource.data.status
                        && validVenue(request.resource.data))
                    || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                        && request.resource.data.status in ['pending', 'live', 'rejected']);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // Public counters for venue owners: each write can only add 1 to one counter.
    match /venueStats/{vid} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['views', 'planAdds'])
                    && request.resource.data.get('views', 0) <= 1 && request.resource.data.get('planAdds', 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['views', 'planAdds'])
                    && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
                         && request.resource.data.views == resource.data.get('views', 0) + 1)
                     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['planAdds'])
                         && request.resource.data.planAdds == resource.data.get('planAdds', 0) + 1));
      allow delete: if false;
    }

    // Places catalogue (read-only from the app) + public likes and reviews per place.
    match /places/{placeId} {
      allow read: if true;
      allow write: if false;

      match /likes/{uid} {
        allow read: if true;
        allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['at']);
        allow delete: if isMe(uid);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
                      && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'stars', 'at'])
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
                      && request.resource.data.name is string && request.resource.data.name.size() <= 80
                      && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    // Each user's private space: profile, favorites, likes mirror, comments mirror.
    match /users/{uid} {
      allow read, write: if isMe(uid);
      match /{document=**} {
        allow read, write: if isMe(uid);
      }
    }

    // Plans: open by link, owner can list their own, only owner edits.
    match /plans/{planId} {
      allow get: if true;
      allow list: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.stops is list
                    && request.resource.data.stops.size() <= 6;
      allow update, delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /votes/{uid} {
        allow get, list: if true;
        allow write: if isMe(uid);
      }
    }

    // Public feed of shared places.
    match /feed/{postId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'pid', 'city', 'emoji', 'text', 'at'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280
                    && request.resource.data.name is string && request.resource.data.name.size() <= 80
                    && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Open outings: small public-place group outings, host approves each member.
    match /meetups/{mid} {
      function mt() { return get(/databases/$(database)/documents/meetups/$(mid)).data; }
      function isHost() { return signedIn() && mt().host == request.auth.uid; }
      function isMember() {
        return signedIn() && (isHost() ||
          (exists(/databases/$(database)/documents/meetups/$(mid)/members/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/meetups/$(mid)/members/$(request.auth.uid)).data.status == 'in'));
      }

      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['host', 'hostName', 'city', 'pid', 'when', 'size', 'note', 'status', 'at'])
                    && request.resource.data.host == request.auth.uid
                    && request.resource.data.size is int && request.resource.data.size >= 3 && request.resource.data.size <= 8
                    && request.resource.data.when is timestamp && request.resource.data.when > request.time
                    && request.resource.data.note is string && request.resource.data.note.size() <= 200
                    && request.resource.data.status == 'open';
      allow update: if signedIn() && resource.data.host == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['open', 'cancelled'];
      allow delete: if false;

      match /members/{uid} {
        allow read: if signedIn();
        // join request (pending) by the person themselves; the host adds themself as 'in' when creating
        allow create: if isMe(uid) && request.resource.data.adult == true
                      && request.resource.data.keys().hasOnly(['name', 'status', 'adult', 'at'])
                      && (request.resource.data.status == 'pending'
                          || (request.resource.data.status == 'in'
                              && getAfter(/databases/$(database)/documents/meetups/$(mid)).data.host == request.auth.uid));
        // only the host changes someone's status
        allow update: if isHost()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                      && request.resource.data.status in ['in', 'declined', 'pending'];
        allow delete: if isMe(uid);
      }

      match /chat/{cid} {
        allow read: if isMember();
        allow create: if isMember()
                      && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300;
        allow update, delete: if false;
      }

      match /reviews/{uid} {
        allow read: if isMember();
        allow create, update: if isMe(uid) && isMember()
                      && request.resource.data.keys().hasOnly(['stars', 'text', 'at'])
                      && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
                      && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      }
    }

    // Reports on posts / reviews: write-only, read from the console.
    match /reports/{id} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['kind', 'ref', 'uid', 'at'])
                    && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // "List my place" requests from venue owners: write-only from the app.
    match /listingRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'city', 'type', 'price', 'contact', 'lang', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120
                    && request.resource.data.contact is string && request.resource.data.contact.size() <= 120;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
